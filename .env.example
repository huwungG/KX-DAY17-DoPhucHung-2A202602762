# Day 17 Memory Systems - environment example
# Copy to .env and fill in the keys you have. All keys are optional.
# If no key is provided, the lab runs in force_offline=True mode.

# LLM_PROVIDER can be: openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=

# Custom (OpenAI-compatible base URL, e.g. Together, vLLM, local server)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Gemini
GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Ollama (local). No API key required.
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Compact memory tuning
COMPACT_THRESHOLD_TOKENS=800
COMPACT_KEEP_MESSAGES=6

# Override offline mode (default: True if no key detected)
# FORCE_OFFLINE=true
